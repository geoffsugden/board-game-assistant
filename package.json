{
  "name": "board-game-assistant",
  "version": "1.0.0",
  "description": "A Small Project for a basic board games scoring app using React and Node.js.",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import ./tests/setup.js --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geoffsugden/board-game-assistant.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/geoffsugden/board-game-assistant/issues"
  },
  "homepage": "https://github.com/geoffsugden/board-game-assistant#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  }
}
